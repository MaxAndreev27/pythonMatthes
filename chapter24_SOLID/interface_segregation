class Workable(ABC):
    @abstractmethod
    def work(self):
        pass


class Eatable(ABC):
    @abstractmethod
    def eat(self):
        pass


# Робот реалізує тільки те, що йому потрібно
class Robot(Workable):
    def work(self):
        print("Робот працює...")


# Людина реалізує обидва інтерфейси
class Human(Workable, Eatable):
    def work(self):
        print("Людина працює...")

    def eat(self):
        print("Людина обідає...")
